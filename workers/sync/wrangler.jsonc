{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bossie-on-that-beat-sync",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bossie-platform",
      "database_id": "9d0c83d3-6b84-4782-8c9f-7070d195a5f8",
      "migrations_dir": "../../migrations"
    }
  ],
  "triggers": {
    "crons": ["0 */6 * * *"]
  },
  "vars": {
    "SYNC_INTERVAL_HOURS": "6",
    "SITE_URL": "https://bossieonthatbeat.com"
  }
}
